Stage 11 — Index creation and deletion
CREATE INDEX ON Students(cgpa)
              │
              ▼
Frontend::create_index()
              │
              ▼
Schema::createIndex()
              │
              ├── Validate relation is open
              ├── Validate attribute
              │
              ▼
BPlusTree::bPlusCreate()
              │
              ├── Allocate root block
              ├── Update RootBlock in AttrCache
              ├── Read every relation record
              │
              └── BPlusTree::bPlusInsert()
                      │
                      ├── findLeafToInsert()
                      ├── insertIntoLeaf()
                      ├── splitLeaf()
                      ├── insertIntoInternal()
                      ├── splitInternal()
                      └── createNewRoot()

DROP INDEX ON Students(cgpa)
              │
              ▼
Frontend::drop_index()
              │
              ▼
Schema::dropIndex()
              │
              ├── Get RootBlock from AttrCache
              │
              ▼
BPlusTree::bPlusDestroy()
              │
              ├── Check block type
              ├── If leaf: release block
              └── If internal:
                     Recursively destroy children
              │
              ▼
Update RootBlock = -1
              │
              ▼
OpenRelTable::closeRel()
              │
              ▼
Write updated attribute catalog


insertIntoLeaf()
      │
      ▼
Is leaf full?
      │
      ├── No → Insert entry
      │
      └── Yes
            │
            ▼
         splitLeaf()
            │
            ▼
      Insert separator
            │
            ▼
    insertIntoInternal()
            │
            ▼
     Is internal full?
            │
            ├── No → Done
            │
            └── Yes → splitInternal()
                          │
                          ▼
                    createNewRoot()

Stage 12 — Join on relations
SELECT * FROM R1 JOIN R2 INTO R3
WHERE R1.attr1 = R2.attr2
                 │
                 ▼
            Algebra::join()
                 │
                 ├── Validate R1 and R2
                 ├── Find join attributes
                 ├── Check attribute types
                 ├── Validate attribute names
                 │
                 ├── Check index on R2.attr2
                 │       │
                 │       └── If absent:
                 │              BPlusTree::bPlusCreate()
                 │
                 ├── Schema::createRel(R3)
                 │
                 ▼
          Fetch R1 records
                 │
                 ▼
          BlockAccess::project()
                 │
                 ▼
          For every R1 record
                 │
                 ▼
          BlockAccess::search(R2)
                 │
                 ▼
          BPlusTree::bPlusSearch()
                 │
                 ▼
          Fetch matching R2 records
                 │
                 ▼
          Combine both records
                 │
                 ▼
          BlockAccess::insert(R3)
                 │
                 ▼
          Repeat until R1 exhausted
